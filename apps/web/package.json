{
  "name": "nocit-web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently --names FE,BE,SSH --prefix-colors cyan,yellow,green \"vite\" \"cd ../../services/api && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000\" \"python ../../services/ssh_gateway/ssh_gateway.py\"",
    "dev-vite": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "python -m pytest ../../tests/scripts/ -v"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/compiler-sfc": "^3.5.14",
    "concurrently": "^8.2.2",
    "eslint": "^9.27.0",
    "eslint-plugin-vue": "^10.1.0",
    "happy-dom": "^8.1.0",
    "prettier": "^3.5.3",
    "@vue/language-core": "^3.2.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^1.1.7",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^3.2.5"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^2.4.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.4.0",
    "vue-router": "^4.5.1",
    "xlsx": "^0.18.5"
  }
}
